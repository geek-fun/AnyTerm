{
  "name": "anyterm",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "description": "Lightweight SSH client & terminal for macOS, Windows and Linux. Save hosts and credentials once, then run commands over SSH in multi-tab xterm.js sessions. Privacy-first, open-source, built with Tauri (Rust).",
  "keywords": [
    "ssh",
    "ssh-client",
    "ssh-manager",
    "terminal",
    "xtermjs",
    "shell",
    "remote-development",
    "tauri",
    "tauri-app",
    "rust",
    "vue",
    "vue3",
    "typescript",
    "naive-ui",
    "cross-platform",
    "desktop-app",
    "open-source",
    "privacy-first",
    "developer-tools"
  ],
  "author": "geekfun <support@geekfun.club>",
  "homepage": "https://www.geekfun.club",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/geek-fun/AnyTerm.git"
  },
  "bugs": {
    "url": "https://github.com/geek-fun/AnyTerm/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:fix": "eslint --fix ./",
    "lint:check": "eslint ./",
    "prepare": "husky install",
    "test": "jest --runInBand --coverage --coverageReporters json-summary text html lcov",
    "test:debug": "DEBUG='jest-search' jest --runInBand --coverage --coverageReporters json-summary text html lcov",
    "test:ci": "jest --runInBand --ci --coverage --coverageReporters json-summary text html lcov"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@xterm/xterm": "^5.5.0",
    "oh-vue-icons": "^1.0.0-rc3",
    "pinia": "^4.1.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "ulidx": "^2.4.1",
    "vue": "^3.5.46",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.5.1",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "naive-ui": "^2.45.3",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.8",
    "vue-tsc": "~3.2.4",
    "@eslint/js": "^10.0.1",
    "globals": "^17.14.0",
    "vue-eslint-parser": "^10.4.2"
  }
}
