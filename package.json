{
  "name": "anyterm",
  "private": true,
  "version": "0.0.5",
  "type": "module",
  "description": "Lightweight SSH client & terminal for macOS, Windows and Linux. Save hosts and credentials once, then run commands over SSH in multi-tab xterm.js sessions. Privacy-first, open-source, built with Tauri (Rust).",
  "keywords": [
    "ssh",
    "ssh-client",
    "ssh-manager",
    "terminal",
    "xtermjs",
    "shell",
    "remote-development",
    "tauri",
    "tauri-app",
    "rust",
    "vue",
    "vue3",
    "typescript",
    "naive-ui",
    "cross-platform",
    "desktop-app",
    "open-source",
    "privacy-first",
    "developer-tools"
  ],
  "author": "geekfun <support@geekfun.club>",
  "homepage": "https://www.geekfun.club",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/geek-fun/AnyTerm.git"
  },
  "bugs": {
    "url": "https://github.com/geek-fun/AnyTerm/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint:fix": "eslint --fix ./",
    "lint:check": "eslint ./",
    "prepare": "husky install",
    "test": "jest --runInBand --coverage --coverageReporters json-summary text html lcov",
    "test:debug": "DEBUG='jest-search' jest --runInBand --coverage --coverageReporters json-summary text html lcov",
    "test:ci": "jest --runInBand --ci --coverage --coverageReporters json-summary text html lcov"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-store": "^2.5.1",
    "@xterm/xterm": "^5.5.0",
    "oh-vue-icons": "^1.0.0-rc3",
    "pinia": "^2.3.1",
    "pinia-plugin-persistedstate": "^3.2.3",
    "ulidx": "^2.4.1",
    "vue": "^3.5.46",
    "vue-i18n": "^9.14.5",
    "vue-router": "^4.6.5",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^9.33.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "naive-ui": "^2.45.3",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "unplugin-auto-import": "^0.17.8",
    "unplugin-vue-components": "^0.27.5",
    "vite": "^5.4.21",
    "vue-tsc": "^2.2.12"
  }
}
